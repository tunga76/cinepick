FROM node:24.19-alpine AS build
WORKDIR /app
RUN corepack enable
COPY src/frontend/cinepick-web/package.json src/frontend/cinepick-web/pnpm-lock.yaml src/frontend/cinepick-web/pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
COPY src/frontend/cinepick-web/ .
RUN pnpm build

FROM nginx:1.29-alpine
RUN apk upgrade --no-cache
ENV API_UPSTREAM=api:8080 \
    NGINX_ENVSUBST_FILTER=API_UPSTREAM
COPY deploy/nginx.conf /etc/nginx/templates/default.conf.template
COPY --from=build /app/dist/cinepick-web/browser /usr/share/nginx/html
EXPOSE 80
